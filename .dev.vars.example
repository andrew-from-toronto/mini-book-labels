# Copy to .dev.vars (ignored by git) and fill in. In production these are Worker secrets:
#   pnpm exec wrangler secret put NAME
# Never commit real values.

# Stripe: a sandbox key for development (sk_test_ or rk_test_), a restricted live key in production.
STRIPE_API_KEY=
# Stripe's publishable key (pk_test_ or pk_live_). Public by design; the Worker hands it to the checkout page.
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=

# Chit Chats: Settings > Developer > API Access Tokens, and the account's client id.
CHITCHATS_API_KEY=
CHITCHATS_CLIENT_ID=
# Leave empty for live. For staging (free, fake labels), set this and use the staging account's key and
# client id above: https://staging.chitchats.com
CHITCHATS_BASE_URL=

# Where blanks are made and shipped from: the manufacturer address on customs forms.
SHIP_FROM_NAME=
SHIP_FROM_STREET=
SHIP_FROM_STREET_2=
SHIP_FROM_CITY=
SHIP_FROM_PROVINCE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=CA

# Mailgun, for order emails. Without these, orders are still recorded but no emails go out.
# API key: Mailgun > Account settings > API security. Domain: the sending domain set up in Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Only for an EU Mailgun account: https://api.eu.mailgun.net
MAILGUN_BASE_URL=
# Must be an address on MAILGUN_DOMAIN: Mailgun refuses other domains as "unverified".
MAIL_FROM="Mini Book Ornaments <support@email.minibookornaments.com>"
# Where buyers' replies go (optional; MAIL_FROM otherwise).
MAIL_REPLY_TO=
# Where new-order notices go.
ORDER_NOTIFY_TO=

# Cloudflare Access for /admin: the Zero Trust team domain and the Access application's AUD tag.
# Leave empty locally: admin then opens on localhost only.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
